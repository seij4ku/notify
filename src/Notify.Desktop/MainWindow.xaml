<Window x:Class="Notify.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notify" Height="760" Width="1100" MinHeight="600" MinWidth="850" Background="#F4F6F8">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#14243A" Padding="14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="NOTIFY" FontSize="22" FontWeight="Bold" Foreground="White" Margin="8,12,8,30"/>
          <Button Content="Firefox capture" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6" Click="ShowFirefox_Click"/>
          <Button Content="Screen OCR" HorizontalContentAlignment="Left" Padding="12,10" Margin="0,0,0,6" Click="ShowOcr_Click"/>
          <Button Content="Research packs" HorizontalContentAlignment="Left" Padding="12,10" Click="ShowResearch_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Local-first Obsidian tools" Foreground="#9FB2C8" Margin="8,12"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
        <Button Content="Settings" DockPanel.Dock="Right" Padding="16,8" Click="Settings_Click"/>
        <TextBlock x:Name="PageTitle" Text="Firefox capture" FontSize="25" FontWeight="SemiBold" Foreground="#172B4D" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1">
        <StackPanel x:Name="FirefoxView" Visibility="Visible">
          <GroupBox Header="Connect Firefox" Padding="16" Background="White">
            <StackPanel>
              <TextBlock Text="The temporary add-on is loaded. Link this app as its native messaging host to save pages directly to your processed notes folder." TextWrapping="Wrap" Foreground="#475569"/>
              <DockPanel Margin="0,14,0,0">
                <Button Content="Link desktop app to Firefox" DockPanel.Dock="Right" Padding="14,8" Click="LinkFirefox_Click"/>
                <TextBox x:Name="ExtensionIdBox" IsReadOnly="True" Text="notify-capture@local" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
              </DockPanel>
              <TextBlock x:Name="FirefoxStatus" Margin="0,10,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
              <TextBlock x:Name="NotesFolderSummary" Margin="0,12,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <StackPanel x:Name="OcrView" Visibility="Collapsed">
          <GroupBox Header="Screen region to text" Padding="16" Background="White">
            <StackPanel>
              <TextBlock Text="Select a region to copy it to the clipboard and send it to OpenAI for cleaned OCR. No screenshot file is created." TextWrapping="Wrap" Foreground="#475569"/>
              <StackPanel Orientation="Horizontal" Margin="0,14,0,10">
                <Button Content="Select region" Padding="16,9" Click="Capture_Click"/>
                <TextBlock x:Name="HotkeySummary" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#64748B"/>
              </StackPanel>
              <TextBlock x:Name="OcrStatus" Margin="0,0,0,8" Foreground="#64748B" TextWrapping="Wrap"/>
              <TextBox x:Name="ResultBox" Height="430" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
              <Button Content="Copy text" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,7" Click="Copy_Click"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>

        <Grid x:Name="ResearchView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <GroupBox Header="Search vault" Padding="12" Background="White">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Text"/><TextBox x:Name="QueryBox" Margin="0,4,0,0" Padding="5"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Tags (comma separated; all must match)"/><ComboBox x:Name="TagsBox" IsEditable="True" StaysOpenOnEdit="True" Margin="0,4,0,0" Padding="5"/></StackPanel>
              <Button Grid.Column="2" Content="Search" VerticalAlignment="Bottom" Padding="15,7" Click="Search_Click"/>
            </Grid>
          </GroupBox>
          <Grid Grid.Row="1" Margin="0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><TextBlock Text="Filtered notes" Margin="0,0,0,5"/><ListBox x:Name="ResultsList" Height="300" SelectionMode="Extended" DisplayMemberPath="Label" Background="White"/></StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10"><Button Content="Add →" Click="AddNotes_Click" Padding="12,7"/><Button Content="← Remove" Click="RemoveNotes_Click" Margin="0,8,0,0" Padding="12,7"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Pack selection" Margin="0,0,0,5"/><ListBox x:Name="PackList" Height="300" SelectionMode="Extended" DisplayMemberPath="Label" Background="White"/></StackPanel>
          </Grid>
          <TextBlock x:Name="ResearchStatus" Grid.Row="2" Margin="0,0,0,10" Foreground="#64748B" TextWrapping="Wrap"/>
          <DockPanel Grid.Row="3">
            <Button Content="Create pack from selection" DockPanel.Dock="Right" Padding="15,8" Click="CreatePack_Click"/>
            <TextBox x:Name="PackNameBox" Text="Focused learning" Margin="0,0,10,0" Padding="6" VerticalContentAlignment="Center"/>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>

<Window x:Class="Notify.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notify" Icon="{StaticResource NotifyLogo}" Height="760" Width="1100" MinHeight="500" MinWidth="750" Background="#FF202123">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#FF27282A" BorderBrush="#FF383A3D" BorderThickness="0,0,1,0" Padding="14">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="6,8,8,24">
            <Image Source="{StaticResource NotifyLogo}" Width="38" Height="38" Margin="0,0,10,0"/>
            <TextBlock Text="Notify" FontSize="23" FontWeight="SemiBold" Foreground="#FFE8E8E9" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Content="Firefox capture" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="12,10" Margin="0,0,0,4" Click="ShowFirefox_Click"/>
          <Button Content="Screen OCR" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="12,10" Margin="0,0,0,4" Click="ShowOcr_Click"/>
          <Button Content="Research packs" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Padding="12,10" Click="ShowResearch_Click"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Local-first Obsidian tools" Foreground="#FF9B9DA1" Margin="8,12"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="24">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,18">
        <Button Content="Settings" DockPanel.Dock="Right" Padding="16,8" Click="Settings_Click"/>
        <TextBlock x:Name="PageTitle" Text="Firefox capture" FontSize="25" FontWeight="SemiBold" Foreground="#FFE8E8E9" VerticalAlignment="Center"/>
      </DockPanel>
      <Grid Grid.Row="1">
        <Grid x:Name="FirefoxView" Visibility="Visible">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <GroupBox Grid.Row="0" Header="Connect Firefox" Padding="16" Background="#FF27282A">
            <StackPanel>
              <TextBlock Text="Choose a page range in Firefox. Notify will process it here and save the reviewed note to your configured folder." TextWrapping="Wrap" Foreground="#FF9B9DA1"/>
              <DockPanel Margin="0,14,0,0">
                <Button Content="Link desktop app to Firefox" DockPanel.Dock="Right" Padding="14,8" Click="LinkFirefox_Click"/>
                <TextBox x:Name="ExtensionIdBox" IsReadOnly="True" Text="notify-capture@local" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
              </DockPanel>
              <TextBlock x:Name="FirefoxStatus" Margin="0,10,0,0" Foreground="#FFFF2D65" TextWrapping="Wrap"/>
              <TextBlock x:Name="NotesFolderSummary" Margin="0,12,0,0" Foreground="#FF9B9DA1" TextWrapping="Wrap"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Grid.Row="1" Header="Page capture" Padding="16" Margin="0,12,0,0" Background="#FF27282A">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="FirefoxPageTitle" FontSize="20" FontWeight="SemiBold" Foreground="#FFFF2D65" TextWrapping="Wrap"/>
              <TextBlock x:Name="FirefoxProgress" Grid.Row="1" Margin="0,8,0,10" Foreground="#FFB4B5B8" TextWrapping="Wrap"/>
              <TextBox x:Name="FirefoxOutput" Grid.Row="2" MinHeight="90" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" IsEnabled="False"/>
              <Button x:Name="FirefoxSaveButton" Grid.Row="3" Content="Save processed note" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="15,8" Click="SaveFirefoxNote_Click" IsEnabled="False"/>
            </Grid>
          </GroupBox>
        </Grid>

        <Grid x:Name="OcrView" Visibility="Collapsed">
          <GroupBox Header="Screen region to text" Padding="16" Background="#FF27282A">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="Select a region to copy it to the clipboard and send it to Claude Code for cleaned OCR. The temporary screenshot is deleted after processing." TextWrapping="Wrap" Foreground="#FF9B9DA1"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
                <Button Content="Select region" Padding="16,9" Click="Capture_Click"/>
                <TextBlock x:Name="HotkeySummary" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#FF9B9DA1"/>
              </StackPanel>
              <TextBlock x:Name="OcrStatus" Grid.Row="2" Margin="0,0,0,8" Foreground="#FF9B9DA1" TextWrapping="Wrap"/>
              <TextBox x:Name="ResultBox" Grid.Row="3" MinHeight="90" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
              <Button Grid.Row="4" Content="Copy text" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,7" Click="Copy_Click"/>
            </Grid>
          </GroupBox>
        </Grid>

        <Grid x:Name="ResearchView" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <GroupBox Header="Search vault" Padding="12" Background="#FF27282A">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Text"/><TextBox x:Name="QueryBox" Margin="0,4,0,0" Padding="5"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Tags (comma separated; all must match)"/><ComboBox x:Name="TagsBox" IsEditable="True" StaysOpenOnEdit="True" Margin="0,4,0,0" Padding="5"/></StackPanel>
              <Button Grid.Column="2" Content="Search" VerticalAlignment="Bottom" Padding="15,7" Click="Search_Click"/>
            </Grid>
          </GroupBox>
          <Grid Grid.Row="1" Margin="0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Filtered notes" Margin="0,0,0,5"/><ListBox Grid.Row="1" x:Name="ResultsList" MinHeight="80" SelectionMode="Extended" DisplayMemberPath="Label" Background="#FF27282A"/></Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10"><Button Content="Add →" Click="AddNotes_Click" Padding="12,7"/><Button Content="← Remove" Click="RemoveNotes_Click" Margin="0,8,0,0" Padding="12,7"/></StackPanel>
            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Pack selection" Margin="0,0,0,5"/><ListBox Grid.Row="1" x:Name="PackList" MinHeight="80" SelectionMode="Extended" DisplayMemberPath="Label" Background="#FF27282A"/></Grid>
          </Grid>
          <TextBlock x:Name="ResearchStatus" Grid.Row="2" Margin="0,0,0,10" Foreground="#FF9B9DA1" TextWrapping="Wrap"/>
          <DockPanel Grid.Row="3">
            <Button Content="Create pack from selection" DockPanel.Dock="Right" Padding="15,8" Click="CreatePack_Click"/>
            <TextBox x:Name="PackNameBox" Margin="0,0,10,0" Padding="6" VerticalContentAlignment="Center"/>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>

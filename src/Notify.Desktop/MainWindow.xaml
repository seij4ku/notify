<Window x:Class="Notify.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notify" Height="560" Width="760" MinHeight="420" MinWidth="600">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Rough notes folder" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,14"><Button Content="Browse…" DockPanel.Dock="Right" Padding="12,5" Click="Browse_Click"/><TextBox x:Name="FolderBox" Margin="0,0,8,0" VerticalContentAlignment="Center"/></DockPanel></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><Button Content="Capture screen region" Padding="14,8" Click="Capture_Click"/><Button Content="Install Pix2Text" Margin="8,0,0,0" Padding="14,8" Click="Install_Click"/><TextBlock x:Name="Status" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
    <TextBox x:Name="ResultBox" Grid.Row="2" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Copy Markdown" Padding="14,7" Click="Copy_Click"/></StackPanel>
  </Grid>
</Window>

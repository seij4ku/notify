<Window x:Class="Notify.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Notify" Height="780" Width="820" MinHeight="620" MinWidth="660" Background="#F4F6F8">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
    <TextBlock Text="Notify" FontSize="28" FontWeight="SemiBold" Foreground="#172B4D"/>
    <TextBlock Text="Local capture for Obsidian" Margin="0,2,0,18" Foreground="#64748B"/>
    <GroupBox Header="Firefox extension" Padding="14" Margin="0,0,0,14" Background="White">
      <StackPanel>
        <TextBlock Text="The extension is loaded. Link this desktop app so Firefox can send page captures directly to your notes folder." TextWrapping="Wrap" Foreground="#475569"/>
        <DockPanel Margin="0,12,0,0">
          <Button Content="Link desktop app to Firefox" DockPanel.Dock="Right" Padding="14,7" Click="LinkFirefox_Click"/>
          <TextBox x:Name="ExtensionIdBox" IsReadOnly="True" Text="notify-capture@local" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
        </DockPanel>
        <TextBlock x:Name="FirefoxStatus" Margin="0,9,0,0" Foreground="#64748B" TextWrapping="Wrap"/>
      </StackPanel>
    </GroupBox>

    <GroupBox Header="Screen capture and local OCR" Padding="14" Margin="0,0,0,14" Background="White">
      <StackPanel>
        <TextBlock Text="Rough notes folder" FontWeight="SemiBold"/>
        <DockPanel Margin="0,6,0,12">
          <Button Content="Browse…" DockPanel.Dock="Right" Padding="12,5" Click="Browse_Click"/>
          <TextBox x:Name="FolderBox" Margin="0,0,8,0" VerticalContentAlignment="Center"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <Button Content="Select region and run OCR" Padding="14,8" Click="Capture_Click"/>
          <Button Content="Install / update local OCR" Margin="8,0,0,0" Padding="14,8" Click="Install_Click"/>
        </StackPanel>
        <TextBlock x:Name="OcrStatus" Margin="0,0,0,8" Foreground="#64748B" TextWrapping="Wrap"/>
        <TextBox x:Name="ResultBox" Height="190" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas"/>
        <Button Content="Copy Markdown" HorizontalAlignment="Right" Margin="0,10,0,0" Padding="14,7" Click="Copy_Click"/>
      </StackPanel>
    </GroupBox>

    <Expander Header="Optional cloud model API key" IsExpanded="False" Background="White" Padding="10">
      <StackPanel Margin="4,10,4,2">
        <TextBlock Text="Saved encrypted for your Windows account. Local Pix2Text OCR does not use this key; a cloud provider is not configured." TextWrapping="Wrap" Foreground="#64748B"/>
        <DockPanel Margin="0,10,0,0">
          <Button Content="Save key" DockPanel.Dock="Right" Padding="14,7" Click="SaveApiKey_Click"/>
          <PasswordBox x:Name="ApiKeyBox" Margin="0,0,8,0" Padding="5"/>
        </DockPanel>
        <TextBlock x:Name="ApiKeyStatus" Margin="0,8,0,0" Foreground="#64748B"/>
      </StackPanel>
    </Expander>
  </StackPanel></ScrollViewer>
</Window>
